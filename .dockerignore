.github/
.claude/
__pycache__/
*.pyc
*.db
*.db-shm
*.db-wal
# Secrets & PHI — never bake into an image. .gcloudignore already keeps these
# out of `gcloud run deploy --source .`; this guards a plain `docker build` too.
backend/users.json
backend/sessions.json
backend/phi_access_log.json
.env
backend/.env
*.env
backend/prescan_cache.json
backend/stdout*.log
backend/stderr*.log
backend/uvicorn.log
backend/*.bat
backend/test_*.py
*.md
.firebase/

# Private investigator packets and sealed coordinator mappings
backend/private_evaluations/
backend/private_validations/

# Local stage snapshots, operator case state, credentials and datasets must
# never enter a container through COPY backend/.
backend/.tmp/
backend/backups/
backend/evidence/
backend/tests/
backend/**/*.json
!backend/oig_exclusions.json
!backend/npi_deactivations.json
backend/**/*.parquet
backend/**/*.csv
backend/**/*.log
**/*sa-key*.json
**/service-account*.json
**/.env*
.codex/
.agents/
**/*.log
